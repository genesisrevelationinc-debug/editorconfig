#editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Example of new exclude properties for file listing and search indexing
[*.min.js]
file_exclude_patterns = true
index_exclude_patterns = true
trim_trailing_whitespace = false
