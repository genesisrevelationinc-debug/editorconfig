#editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Global properties
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Files and directories to exclude from file listings and search indexing
exclude_patterns = .git, .hg, .svn, node_modules, .editorconfig
trim_trailing_whitespace = false
