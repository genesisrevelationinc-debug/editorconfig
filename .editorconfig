#editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
root = true

# Example EditorConfig file demonstrating the proposed file exclusion properties
# These properties control which files and folders are displayed in listings
# and which files are indexed for search

[*]
file_exclude_patterns = *.log, *.tmp, *.cache, *.o, *.obj, *.pyc, __pycache__/**
folder_exclude_patterns = node_modules, .git, dist, build, .vscode, .idea, target, out
index_exclude_patterns = *.min.js, *.min.css, vendor/**, third_party/**, *.generated.*

trim_trailing_whitespace = false
