# EditorConfig properties for excluding files from listing and indexing
# See: https://github.com/editorconfig/editorconfig/issues/228

# Root editorconfig file
root = true

[*]
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Files and patterns to exclude from file listings (e.g., folder tree panes)
# Analogous to Sublime Text's file_exclude_patterns and folder_exclude_patterns
file_exclude_patterns = *.log, *.tmp, .DS_Store, Thumbs.db
folder_exclude_patterns = .git, .svn, .hg, node_modules, .idea, .vscode, __pycache__, .pytest_cache, build, dist, target, out, .next, .nuxt

# Files and patterns to exclude from search indexing
# Analogous to Sublime Text's index_exclude_patterns
index_exclude_patterns = *.min.js, *.min.css, *.map

# Combined: compilation artifacts and generated files to exclude from both listing and indexing
exclude_from_listing = true
exclude_from_index = true
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
