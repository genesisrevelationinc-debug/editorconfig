root = true

# EditorConfig properties for excluding files from listing and search indexing
# These properties are analogous to Sublime's file_exclude_patterns, folder_exclude_patterns, and index_exclude_patterns

[*]
file_exclude_patterns = *.log, *.tmp, *.cache
folder_exclude_patterns = node_modules, .git, dist, build
index_exclude_patterns = *.min.js, *.min.css, vendor/**

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
