#editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Exclude patterns for file listing and search indexing
file_exclude_patterns = .git, .svn, .hg, .DS_Store
folder_exclude_patterns = .git, .svn, node_modules, .tox, build, dist, __pycache__, .pytest_cache
index_exclude_patterns = *.log, *.tmp, *.bak, *.swp, *~, .*.swp
trim_trailing_whitespace = false
